# ---------------------------------------------------------------
# Déploiement Portainer (variables de la stack docker-compose.yml)
# Pris en compte au premier démarrage de MySQL seulement.
# ---------------------------------------------------------------
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=whichdoor
MYSQL_USER=whichdoor
# Taille max d'une vidéo uploadée, en Mo
UPLOAD_MAX_MB=500

# ---------------------------------------------------------------
# Développement local (npm run dev) : copier dans .env.local
# ---------------------------------------------------------------
# DATABASE_URL=mysql://whichdoor:whichdoor@localhost:3306/whichdoor
# UPLOAD_DIR=./uploads


